# Gomgom — environment configuration (NFR-36).
# Copy to .env.local and fill in. NEVER commit real secrets.

# --- Supabase (real product catalog: normalized_products, source_freshness) ---
# SERVICE key is server-only — used by /api/v1/optimize to query products.
# Without these, the app falls back to the built-in mock catalog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Self-trained NER model (TensorFlow course artifact) — model="self" ---
# Points to the local Python GPT-2 service (gomgom-ner-service).
GEMMA_NER_URL=
GEMMA_NER_API_KEY=

# --- External LLM provider (disclosed) — model="api" ---
# Used for product-quality extraction, clearly labeled in the UI as external API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Route distance provider (FR-14, Q1/Q4) ---
# OSRM (self-hosted, free) or Google Maps Distance Matrix (paid).
OSRM_BASE_URL=
GOOGLE_MAPS_API_KEY=
