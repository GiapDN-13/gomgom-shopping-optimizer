# Gomgom — environment configuration (NFR-36).
# Copy to .env.local and fill in. NEVER commit real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Fine-tuned Gemma NER endpoint (FR-03) ---
# Leave GEMMA_NER_URL empty during Sprint 1 to use the built-in mock response.
GEMMA_NER_URL=
GEMMA_NER_API_KEY=

# --- Route distance provider (FR-14, Q1/Q4) ---
# OSRM (self-hosted, free) or Google Maps Distance Matrix (paid).
OSRM_BASE_URL=
GOOGLE_MAPS_API_KEY=
